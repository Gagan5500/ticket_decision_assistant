{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Run FastAPI Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.api:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "2. Run Streamlit App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "streamlit_app.py",
                "--server.port",
                "8501"
            ],
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "3. Run Evaluation Benchmark",
            "type": "debugpy",
            "request": "launch",
            "module": "src.evaluate",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "4. Run Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-v"
            ],
            "console": "integratedTerminal"
        }
    ]
}
